# Copy to .env.local for development. Never commit real values.
DATABASE_URL=postgres://klinique:klinique@localhost:5432/klinique

# Long random string used to sign session cookies and hash OTP codes.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Where to send OTP codes. "console" prints them to the server log (development only).
SMS_PROVIDER=console
# Show the OTP code on screen. For demos only; must be false once real SMS is connected.
OTP_DEV_ECHO=true

# First admin account, created by `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
